def ensure(path: str) {
    observe { return state(present: shell { test -d "$path" }.exit == 0) }
    apply {
        r = shell { mkdir -p "$path" }
        if !r { return err.runtime(r) }
        return ok.created
    }
}

# The observe walks the whole tree, because the apply chowns the whole tree.
#
# It used to `stat` the top directory alone while `apply` ran `chown -R`, so a directory
# that already had the right owner was declared converged whatever its contents belonged
# to. Concretely: `/etc/dkimkeys` ships owned by `opendkim`, a key generated inside it
# lands root-owned, `dir.owner` reported `ok.already`, the `chown -R` never ran and the
# daemon could not read its own key — with the run reporting green (#480).
#
# `chown` accepts both `user` and `user:group`, so the check has to accept both: `stat`
# always prints `user:group`, and comparing that string to a plan asking for `covuser`
# reported `changed` on every run, firing every `if x.changed { … }` downstream for
# nothing (#367). Hence splitting the argument and asking `find` about each half.
#
# `-quit` stops at the first offender: the question is "is anything wrong here?", not
# "list everything wrong", and a large tree should not be walked to the end to answer it.
def owner(path: str, owner: str) as root {
    # Convergence is read from `find` printing nothing — so the observe has to be sure it
    # *looked*. Two ways it could print nothing without the tree being right:
    #
    #   - the path does not exist. `find` fails, `2>/dev/null` swallows the message, and the
    #     emptiness read as "nothing here has the wrong owner". A `--dry-run` said
    #     `dir.ensure … would.created` and, one line down, `dir.owner … ok.already` (#507).
    #   - a subdirectory cannot be read. Same silence, same wrong conclusion.
    #
    # Hence the existence test and `|| exit 1`: a `find` that did not complete is not a
    # converged tree. Refusing a missing path in `check` would have been the other fix, and
    # it is worse — `check` runs in every mode (ADR-0035), so `dir.ensure` followed by
    # `dir.owner` would stop being previewable at all (#508). Drift is the honest answer:
    # the preview says `would.changed`, and an apply fails on `chown` with a message that
    # names the path.
    observe {
        return state(owned: shell {
            u="${owner%%:*}"
            g="${owner#*:}"
            [ -d "$path" ] || exit 1
            if [ "$g" = "$owner" ]; then
                out="$(find "$path" ! -user "$u" -print -quit 2>&1)" || exit 1
            else
                out="$(find "$path" \( ! -user "$u" -o ! -group "$g" \) -print -quit 2>&1)" || exit 1
            fi
            [ -z "$out" ]
        }.exit == 0)
    }
    apply {
        r = shell { chown -R "$owner" "$path" }
        if !r { return err.runtime(r) }
        return ok.changed
    }
}

# The mode of the directory itself, not of its contents.
#
# `file.mode` chmods a directory perfectly well — `chmod` does not care what its target is —
# so this def adds no capability. It adds a call site that does not lie: the first dogfood
# wrote `file.mode("/var/backups/app", "750")` for a directory holding database dumps, and
# `dir.ensure` / `dir.owner` / `dir.copy` / `dir.sync` all existed while this one did not
# (#505).
#
# **Not recursive**, unlike `dir.owner`. That def chowns the whole tree and walks it to
# observe, because the two must agree — a top-level-only observe over a `chown -R` is what
# #480 was. Here the operation is the directory's own bits, which is what a caller writing
# `dir.mode` means; a recursive variant would be a different operation, and it would need an
# observe that walks. If it is ever wanted it arrives as a parameter, with that observe.
def mode(path: str, mode: str) {
    observe { return state(mode: shell { stat -c '%a' "$path" 2>/dev/null }.stdout) }
    apply {
        r = shell { chmod "$mode" "$path" }
        if !r { return err.runtime(r) }
        return ok.changed
    }
}

# A read-only question: no apply phase, deterministic in check (never `would`).
def exists(path: str) {
    check {
        r = shell { test -d "$path" }
        if r { return ok.present }
        return err.absent
    }
}

# Deliver a control-host tree to the target (ADR-0036 §6, ADR-0039). A def over
# `~dir.sync` with `delete = "false"`: **a copy is a sync that deletes nothing** — what is
# already on the target and absent from the source is left alone.
#
# `src` must be marked `%"…"` at the call site: the tree is read on the control host, and
# an unmarked path would name a directory on the target, which is a different operation.
#
# The transfer sends only what differs, so a converged tree costs one round trip and zero
# bytes — the property the old control-side expansion never had, since it inlined the
# whole tree into the request on every run and refused above 32 MB.
#
# `compare` defaults to size+mtime. Its limit is documented rather than discovered: a
# change that preserves both is invisible to it — a restored backup with preserved
# timestamps is the realistic case. Pass `compare = "sha256"` when that matters.
def copy(src: str, dst: str, compare: str = "meta") {
    apply {
        # The transfer reports how many files it wrote, so the verdict comes from the work
        # itself — no `observe` walking the tree a second time to ask a question the sync
        # already answered.
        n = ~dir.sync(src, dst, "false", compare)
        if n == "0" { return ok.already }
        return ok.copied
    }
}

# Make the target match the source exactly — including by **removing** what the source
# does not have (ADR-0036 §6, #373). One word apart from `dir.copy`, and that word
# deletes, so the difference is stated everywhere it can be:
#
#   dir.copy(%"site", "/var/www")   delivers, leaves anything else alone
#   dir.sync(%"site", "/var/www")   delivers, and removes the rest
#
# The `preview` phase is not decoration. `apply` never runs in `--dry-run`, so without it
# this def would announce `would.synced` and name not one file it would delete — in a tool
# whose thesis is that a run is readable before it happens, that is a design defect. The
# primitive is inert in check mode, so previewing costs a manifest exchange and touches
# nothing.
def sync(src: str, dst: str, compare: str = "meta") {
    preview { ~dir.sync(src, dst, "true", compare) }
    apply {
        n = ~dir.sync(src, dst, "true", compare)
        if n == "0" { return ok.already }
        return ok.synced
    }
}
