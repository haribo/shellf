# Reload systemd's unit files. Action-shaped: run it after writing/patching a
# unit, before `service(...)` enables it.
def systemd-daemon-reload() as root {
    apply {
        r = shell { systemctl daemon-reload }
        if !r { return err.runtime(r) }
        return ok.reloaded
    }
}

# Restart a unit. A "handler": action-shaped (a restart always acts), so gate it
# on a real change — `if conf.changed { service-restart("sshd") }` — to avoid a
# restart on every run.
def service-restart(name: str) as root {
    apply {
        r = shell { systemctl restart "$name" }
        if !r { return err.runtime(r) }
        return ok.restarted
    }
}

# Reload a unit (SIGHUP-style, no downtime). Same handler pattern as
# service-restart — gate it on `.changed`.
def service-reload(name: str) as root {
    apply {
        r = shell { systemctl reload "$name" }
        if !r { return err.runtime(r) }
        return ok.reloaded
    }
}
