def file-download(url: str, dst: str, sha256: str) {
    guard {
        r = shell {
            test -f "$dst" && echo "$sha256  $dst" | sha256sum -c --status
        }
        if r.ok { return ok.already }
    }
    apply {
        r = shell {
            curl -fsSLo "$dst" "$url"
            echo "$sha256  $dst" | sha256sum -c --status
        }
        if r.exit != 0 { return err.runtime(r) }
    }
    return ok.downloaded
}

def file-write(path: str, content: str) {
    guard {
        r = shell { test -f "$path" && printf '%s' "$content" | cmp -s - "$path" }
        if r.ok { return ok.already }
    }
    apply {
        r = shell { printf '%s' "$content" > "$path" }
        if r.exit != 0 { return err.runtime(r) }
    }
    return ok.written
}

def file-line(path: str, line: str) {
    guard {
        r = shell { grep -qF -- "$line" "$path" }
        if r.ok { return ok.already }
    }
    apply {
        r = shell { printf '%s\n' "$line" >> "$path" }
        if r.exit != 0 { return err.runtime(r) }
    }
    return ok.added
}

def file-delete(path: str) {
    guard {
        r = shell { test ! -e "$path" }
        if r.ok { return ok.already }
    }
    apply {
        r = shell { rm -rf -- "$path" }
        if r.exit != 0 { return err.runtime(r) }
    }
    return ok.deleted
}

# A read-only question: no apply phase -> deterministic in check (never `would`).
def file-exists(path: str) {
    check {
        r = shell { test -f "$path" }
        if r.ok { return ok.present }
        return err.absent
    }
}
