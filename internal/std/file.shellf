def file-download(url: str, dst: str, sha256: str) {
    guard: shell {
        test -f "$dst" && echo "$sha256  $dst" | sha256sum -c --status
    } -> ok.already when ok

    apply {
        let r = shell {
            curl -fsSLo "$dst" "$url"
            echo "$sha256  $dst" | sha256sum -c --status
        }
        when r.exit != 0 -> err.runtime(r)
    }

    ok.downloaded
}

def file-write(path: str, content: str) {
    guard: shell { test -f "$path" && printf '%s' "$content" | cmp -s - "$path" } -> ok.already when ok

    apply {
        let r = shell { printf '%s' "$content" > "$path" }
        when r.exit != 0 -> err.runtime(r)
    }

    ok.written
}

def file-line(path: str, line: str) {
    guard: shell { grep -qF -- "$line" "$path" } -> ok.already when ok

    apply {
        let r = shell { printf '%s\n' "$line" >> "$path" }
        when r.exit != 0 -> err.runtime(r)
    }

    ok.added
}

def file-delete(path: str) {
    guard: shell { test ! -e "$path" } -> ok.already when ok

    apply {
        let r = shell { rm -rf -- "$path" }
        when r.exit != 0 -> err.runtime(r)
    }

    ok.deleted
}
