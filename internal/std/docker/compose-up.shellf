def compose-up(dir: str) as root {
    # Guard: the stack is already up (services running) -> skip. Known limit:
    # this does not detect a change to the compose file while the stack is up
    # (a config-hash guard would); bring the stack down to force a re-apply.
    guard {
        r = shell { cd "$dir" && docker compose ps --status running --quiet | grep -q . }
        if r { return ok.alreadyUp }
    }
    apply {
        r = shell {
            cd "$dir"
            docker compose up -d
        }
        if !r { return err.runtime(r) }
        return ok.up
    }
}
