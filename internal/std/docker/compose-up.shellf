# Bring a compose stack up (ADR-0013 action-shaped). `docker compose up -d` is
# itself idempotent — it recreates only the services whose image or config
# changed, and is a no-op otherwise — so there is NO observe: a "≥1 service
# running" guard would wrongly skip a compose/image change while the stack is up.
# `build` = "true" rebuilds local images first (images built on the target).
def compose-up(dir: str, build: str = "false") as root {
    # `--dry-run` preview (ADR-0029): the per-service create/recreate/start plan, from
    # `docker compose up --dry-run` (read-only, Compose >= 2.29). Best-effort — an
    # older Compose or an unreachable daemon simply yields no preview. Note: --dry-run
    # does not build, so with build = "true" this shows orchestration, not the rebuild.
    preview { shell { cd "$dir"; docker compose up -d --dry-run --remove-orphans 2>&1 } }
    apply {
        r = shell {
            cd "$dir"
            if [ "$build" = true ]; then
                docker compose up -d --build --remove-orphans
            else
                docker compose up -d --remove-orphans
            fi
        }
        if !r { return err.runtime(r) }
        return ok.up
    }
}
