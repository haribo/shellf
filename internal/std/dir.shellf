def dir-ensure(path: str) {
    guard {
        r = shell { test -d "$path" }
        if r { return ok.already }
    }
    apply {
        r = shell { mkdir -p "$path" }
        if !r { return err.runtime(r) }
        return ok.created
    }
}

def dir-owner(path: str, owner: str) as root {
    guard {
        r = shell { test "$(stat -c '%U:%G' "$path")" = "$owner" }
        if r { return ok.already }
    }
    apply {
        r = shell { chown -R "$owner" "$path" }
        if !r { return err.runtime(r) }
        return ok.changed
    }
}

# A read-only question: no apply phase, deterministic in check (never `would`).
def dir-exists(path: str) {
    check {
        r = shell { test -d "$path" }
        if r { return ok.present }
        return err.absent
    }
}
