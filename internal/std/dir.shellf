def dir-ensure(path: str) {
    guard: shell { test -d "$path" } -> ok.already when ok

    apply {
        r = shell { mkdir -p "$path" }
        when r.exit != 0 -> err.runtime(r)
    }

    ok.created
}

def dir-owner(path: str, owner: str) {
    guard: shell { test "$(stat -c '%U:%G' "$path")" = "$owner" } -> ok.already when ok

    apply {
        r = shell { chown -R "$owner" "$path" }
        when r.exit != 0 -> err.runtime(r)
    }

    ok.changed
}

# A read-only question: no apply phase, so it resolves in pass 1 and is
# deterministic in check (never `would`).
def dir-exists(path: str) {
    check {
        r = shell { test -d "$path" }
        when r.ok -> ok.present
        when true -> err.absent
    }
}
