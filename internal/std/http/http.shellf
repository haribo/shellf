# A read-only question: does an URL return the expected HTTP status? Used to
# validate a deploy — a standalone `http.check("https://x", "200")` halts the run
# if it does not match (a failing question is an err).
def check(url: str, status: str) {
    check {
        r = shell { test "$(curl -so /dev/null -w '%{http_code}' "$url")" = "$status" }
        if r { return ok.match }
        return err.mismatch
    }
}

# Poll an URL until it answers (HTTP < 400), or give up after `timeout` seconds.
# A question with a retry loop in the shell (shellf has no loop yet) — for
# waiting on a service to come up, or for an ACME certificate after the first hit.
def wait-for(url: str, timeout: str) {
    check {
        r = shell {
            end=$(( $(date +%s) + timeout ))
            while [ "$(date +%s)" -lt "$end" ]; do
                curl -sfo /dev/null "$url" && exit 0
                sleep 1
            done
            exit 1
        }
        if r { return ok.ready }
        return err.timeout
    }
}
