def ensure(name: str, running: bool, enabled: bool) as root {
    # Value fields matching the `running`/`enabled` arguments: each is compared,
    # so the same def converges a service up or down.
    observe {
        return state(
            running: shell { systemctl is-active  --quiet "$name" }.exit == 0,
            enabled: shell { systemctl is-enabled --quiet "$name" }.exit == 0,
        )
    }
    apply {
        r = shell {
            if [ "$running" = true ]; then systemctl start "$name"; else systemctl stop "$name"; fi
            if [ "$enabled" = true ]; then systemctl enable "$name"; else systemctl disable "$name"; fi
        }
        if !r { return err.runtime(r) }
        return ok.converged
    }
}

# Restart a unit. A "handler": action-shaped (a restart always acts), so gate it
# on a real change — `if conf.changed { service.restart("sshd") }` — to avoid a
# restart on every run.
def restart(name: str) as root {
    apply {
        r = shell { systemctl restart "$name" }
        if !r { return err.runtime(r) }
        return ok.restarted
    }
}

# Reload a unit (SIGHUP-style, no downtime). Same handler pattern as
# service-restart — gate it on `.changed`.
def reload(name: str) as root {
    apply {
        r = shell { systemctl reload "$name" }
        if !r { return err.runtime(r) }
        return ok.reloaded
    }
}
