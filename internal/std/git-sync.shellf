# Clone a repo, or update an existing checkout to a pinned ref (tag/branch/SHA).
# Unlike git-clone (clone-once), this fetches and hard-checks-out `ref`.
# Converged when HEAD already resolves to `ref`. Warning: `checkout --force`
# discards local changes in `dst` — intended for a deploy checkout, not a workdir.
def git-sync(url: str, dst: str, ref: str) {
    observe {
        return state(atRef: shell {
            test -d "$dst/.git" && test "$(git -C "$dst" rev-parse HEAD 2>/dev/null)" = "$(git -C "$dst" rev-parse "$ref^{commit}" 2>/dev/null)"
        }.exit == 0)
    }
    apply {
        r = shell {
            if [ -d "$dst/.git" ]; then
                git -C "$dst" fetch --all --tags --quiet
            else
                git clone --quiet "$url" "$dst"
            fi
            git -C "$dst" checkout --quiet --force "$ref"
        }
        if !r { return err.runtime(r) }
        return ok.synced
    }
}
