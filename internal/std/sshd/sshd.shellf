# Deliver a validated sshd_config drop-in (#328).
#
# An invalid sshd_config breaks the transport shellf itself uses: on a host without
# another way in, that is provider rescue mode. `sshd -t -f` is the official checker,
# and like visudo it is useless once the file is installed.
#
# Same shape as sudo.write: the validation is in `check`, on its own temporary, so a
# refused content never reaches the write and `--dry-run` catches it before any run.
#
# Note: `sshd -t` also validates the *running* configuration it includes, so a drop-in
# that conflicts with an existing directive is caught here rather than at reload.
def config(name: str, content: str) as root {
    # Same shape, same reason as sudo.write (#340): a composed `apply` is invisible to
    # `--dry-run`, so this def states its own convergence — content, and the mode sshd
    # refuses to start without.
    observe {
        f = "/etc/ssh/sshd_config.d/${name}.conf"
        return state(synced: shell { test -f "$f" && printf '%s\n' "$content" | cmp -s - "$f" }.exit == 0, secured: shell { [ "$(stat -c '%a' "$f" 2>/dev/null)" = "600" ] }.exit == 0)
    }
    check {
        # The name becomes a file under /etc/ssh/sshd_config.d, so it is held to what sshd
        # will read back — the same check `sudo.write` runs, which this def described itself
        # as sharing the shape of and did not have (#617). What is at risk is the path, not
        # injection: sshd includes `*.conf` from that directory, so a name carrying a `/`
        # writes into a subdirectory nothing reads, and the drop-in is silently never
        # applied. `^[A-Za-z0-9_-]+$` still admits the convention — `50-hardening`.
        if !~text.matches(name, "^[A-Za-z0-9_-]+$") { return err.badName }

        r = shell {
            tmp=$(mktemp)
            trap 'rm -f "$tmp"' EXIT
            printf '%s\n' "$content" > "$tmp"
            sshd -t -f "$tmp"
        }
        if !r { return err.validation(r) }
    }
    apply {
        file.write("/etc/ssh/sshd_config.d/${name}.conf", "${content}\n")
        # sshd refuses to start if a config file is group- or world-writable.
        file.mode("/etc/ssh/sshd_config.d/${name}.conf", "600")
        return ok.written
    }
}
