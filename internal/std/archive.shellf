def archive-extract(src: str, dst: str) {
    # Observed: the archive's sha256, recorded in a sentinel under `dst` at extract
    # time, equals the current archive's sha256. So a changed archive at `src`
    # re-extracts, and an unchanged one is skipped (#259). Both hashes are computed
    # target-side, since `src` is a target path.
    observe {
        return state(extracted: shell {
            test -f "$dst/.shellf-archive-sha256" &&
            [ "$(cat "$dst/.shellf-archive-sha256" 2>/dev/null)" = "$(sha256sum "$src" | cut -d' ' -f1)" ]
        }.exit == 0)
    }
    apply {
        r = shell {
            mkdir -p "$dst"
            tar xzf "$src" -C "$dst"
            sha256sum "$src" | cut -d' ' -f1 > "$dst/.shellf-archive-sha256"
        }
        if !r { return err.runtime(r) }
        return ok.extracted
    }
}

def git-clone(url: str, dst: str) {
    # Observed: the current origin remote (empty if not a repo). The `url` field
    # matches the `url` argument, so a missing clone or a wrong remote both read
    # as drift and trigger apply. A wrong-remote dst then fails the clone
    # (destination exists) -> err.runtime, rather than silently accepting it.
    observe { return state(url: shell { git -C "$dst" remote get-url origin 2>/dev/null }.stdout) }
    apply {
        r = shell { git clone "$url" "$dst" }
        if !r { return err.runtime(r) }
        return ok.cloned
    }
}
