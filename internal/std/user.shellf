def user-group(user: str, group: str) {
    guard {
        r = shell { id -nG "$user" | tr ' ' '\n' | grep -qx "$group" }
        if r.ok { return ok.already }
    }
    apply {
        r = shell { usermod -aG "$group" "$user" }
        if r.exit != 0 { return err.runtime(r) }
    }
    return ok.added
}
