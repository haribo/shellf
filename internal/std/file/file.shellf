# chmod a path to an exact mode. Path-dependent (not intrinsically root — the
# caller escalates with `as root` for system paths), like dir-ensure/file-write.
# Own one file, without touching anything else in its directory. `dir.owner` chowns a
# whole tree; changing a single file's owner had no instruction at all, so a plan had to
# fall back on `unsafe shell { chown … }` — the escape hatch ADR-0040 exists to make rare
# (#480).
#
# `as root`: giving a file away requires root on Linux whoever owns it, so unlike
# `file.mode` this is intrinsically privileged rather than path-dependent (ADR-0011).
def owner(path: str, owner: str) as root {
    observe {
        return state(owned: shell {
            cur="$(stat -c '%U:%G' "$path" 2>/dev/null)"
            [ "$cur" = "$owner" ] || [ "${cur%%:*}" = "$owner" ]
        }.exit == 0)
    }
    apply {
        r = shell { chown "$owner" "$path" }
        if !r { return err.runtime(r) }
        return ok.changed
    }
}

def mode(path: str, mode: str) {
    observe {
        # `stat` strips a leading zero, so it answers `640` whether the file was chmod'd
        # `640` or `0640` — both of which chmod accepts for the same mode, `0640` being the
        # canonical spelling. Comparing its output to the argument verbatim therefore made
        # the def apply correctly and then report failure, on every run (#543).
        #
        # awk compares the two numerically and echoes back the *caller's* spelling when they
        # match, so a converged mode is equal as a string. When they differ it prints what
        # was actually observed, so the diagnostic still names the real value.
        return state(mode: shell { stat -c '%a' "$path" 2>/dev/null | awk -v want="$mode" '{ if ($1 + 0 == want + 0) print want; else print $1 }' }.stdout)
    }
    apply {
        r = shell { chmod "$mode" "$path" }
        if !r { return err.runtime(r) }
        return ok.changed
    }
}

# Ensure a `key=value` line in a file (e.g. an .env): replace the line if the key
# is present, else append it. Idempotent on the exact line, whatever the value holds —
# an URL with a query string is ordinary input here.
#
# It used to build a sed expression out of its own arguments, so the value was not
# written, it was interpreted: `&` means "the whole matched line" in a replacement, `|`
# was the delimiter, and a key holding `.` matched neighbouring lines. `URL=https://a&b`
# landed as `URL=https://aURL=oldb`, which the observe then refused, so every run rewrote
# and re-corrupted the file (#487). awk reads both through ENVIRON instead: nothing the
# caller passes is ever parsed as syntax.
#
# Still unguarded: a `=` in the key, or a newline in either argument, cannot be written as
# one `key=value` line. Refusing them belongs in `check`, and `check` cannot express it —
# the language compares values with `==` and nothing else, so the only way to ask "does
# this hold a newline" is a shell round trip on the target, in every mode, to validate an
# argument the control host already holds. That contradicts ADR-0034 §5. Tracked as the
# language gap it is (#492), not worked around here.
def replace(path: str, key: str, value: str) {
    check {
        if key == "" { return err.keyMustNotBeEmpty }
    }
    observe { return state(set: shell { grep -qxF -- "$key=$value" "$path" 2>/dev/null }.exit == 0) }
    apply {
        r = shell {
            # Staged like file.write, and for the same reason: the destination is never
            # the thing being written, so nothing reads a half-rewritten file. `cp -p`
            # first so the rename inherits the original mode and owner.
            staged="$path.shellf.$$"
            trap 'rm -f "$staged"' EXIT
            src="$path"
            if [ -f "$path" ]; then cp -p "$path" "$staged"; else src=/dev/null; fi
            # One pass does both branches: rewrite the first line carrying the key, drop
            # any further one (sed left duplicates behind), append when there was none.
            awk 'BEGIN { p = ENVIRON["key"] "="; v = ENVIRON["value"]; n = length(p) }
                 substr($0, 1, n) == p { if (!done) { print p v; done = 1 } next }
                 { print }
                 END { if (!done) print p v }' "$src" > "$staged"
            mv -f "$staged" "$path"
        }
        if !r { return err.runtime(r) }
        return ok.set
    }
}

# Create a file if it is absent, with an exact mode, and never touch its content.
#
# `file.write` always owns the content, so it cannot express "make sure this exists" — and
# `file.write(path, "")` followed by `file.mode` is two steps with a window between them
# where the file carries the umask default. Traefik's ACME store is the case that found it:
# it must exist, be 600 before traefik writes a key into it, and must not be zero-length
# (#502). By the time anyone notices that window, it holds a private key.
#
# `install -m` creates with the mode in one step. On an existing file only the mode is
# reconciled — truncating it would be the defect this def exists to avoid.
def ensure(path: str, mode: str) {
    observe {
        # `-eq` and not `=`: stat answers `640` for a file chmod'd `0640`, so a string
        # compare made this def re-apply for ever on the canonical spelling (#543).
        return state(ready: shell { test -f "$path" && [ "$(stat -c '%a' "$path")" -eq "$mode" ] }.exit == 0)
    }
    apply {
        r = shell {
            if [ -f "$path" ]; then
                chmod "$mode" "$path"
            else
                install -m "$mode" /dev/null "$path"
            fi
        }
        if !r { return err.runtime(r) }
        return ok.ready
    }
}

def download(url: str, dst: str, sha256: str) {
    observe {
        return state(present: shell { test -f "$dst" && echo "$sha256  $dst" | sha256sum -c --status }.exit == 0)
    }
    apply {
        r = shell {
            curl -fsSLo "$dst" "$url"
            echo "$sha256  $dst" | sha256sum -c --status
        }
        if !r { return err.runtime(r) }
        return ok.downloaded
    }
}

# Stage-then-rename, never a redirection at the destination (#298). `> "$path"`
# truncates the file before writing it, so on the happy path — not just on a crash —
# there is a window where a reader sees an empty or partial file. For an sshd_config
# picked up by a concurrent reload, that window is a lockout.
#
# The staging file sits in the destination's own directory so the rename is within one
# filesystem, hence atomic. `cp -p` first (when the destination exists) carries its
# mode and owner onto the staging file: a redirection preserved them, a bare rename
# would silently reset them to the umask default. The trap removes the staging file if
# anything fails; after a successful rename it is already gone.
#
# Content validation is deliberately NOT here (#323): whether a file is valid sudoers or
# a valid sshd_config is the business of an instruction that knows the format, in its
# `check` phase — it writes its own temporary, and `check` runs before any `apply`, so a
# refused content never reaches this def.
def write(path: str, content: str) {
    observe {
        return state(synced: shell { test -f "$path" && printf '%s' "$content" | cmp -s - "$path" }.exit == 0)
    }
    # What `--dry-run` was not saying: `would.written` answers "this file will change", not
    # "here is what changes" — and for an sshd drop-in the difference is whether you are
    # about to lock yourself out (#440). Runs only when the destination has drifted: the
    # `preview` phase is reached on the `would` path alone (ADR-0029).
    #
    # Computed on the target, where both sides already are: the content is this def's own
    # parameter and the file is under its nose, so nothing extra crosses the channel.
    # `diff` is `Essential: yes` on Debian — verified, not assumed.
    #
    # Secrets are handled the way the rest of the output already handles them: by value,
    # masked as `***` wherever they appear (ADR-0018), preview text included. Suppressing
    # the diff instead was considered and dropped — it would only have hidden what the
    # masking already hides, while a secret written into a template by hand is invisible to
    # either mechanism, and is the author's to keep out.
    preview {
        shell {
            if [ ! -f "$path" ]; then
                printf 'new file, %s line(s)\n' "$(printf '%s' "$content" | grep -c '')"
            else
                # `tail -n +3` drops diff's own `---`/`+++` header: it names the target and
                # `-` for stdin, which says nothing the instruction line has not said.
                d=$(printf '%s' "$content" | diff -u "$path" - | tail -n +3)
                total=$(printf '%s' "$d" | grep -c '')
                printf '%s\n' "$d" | head -40
                if [ "$total" -gt 40 ]; then printf '… %s more line(s)\n' "$((total - 40))"; fi
            fi
        }
    }
    apply {
        r = shell {
            staged="$path.shellf.$$"
            trap 'rm -f "$staged"' EXIT
            if [ -f "$path" ]; then cp -p "$path" "$staged"; fi
            printf '%s' "$content" > "$staged"
            mv -f "$staged" "$path"
        }
        if !r { return err.runtime(r) }
        return ok.written
    }
}

# `-x` and not merely `-F`: without it the observe matches a **substring**, so adding
# `foo` to a file already holding `foobar` reports `present` and the line is never
# appended. `file.replace` above has always had the `-x`; this one did not (#388).
def line(path: str, line: str) {
    observe { return state(present: shell { grep -qxF -- "$line" "$path" }.exit == 0) }
    apply {
        r = shell { printf '%s\n' "$line" >> "$path" }
        if !r { return err.runtime(r) }
        return ok.added
    }
}

def delete(path: str) {
    observe { return state(absent: shell { test ! -e "$path" }.exit == 0) }
    apply {
        r = shell { rm -rf -- "$path" }
        if !r { return err.runtime(r) }
        return ok.deleted
    }
}

# A read-only question: no apply phase -> deterministic in check (never `would`).
def exists(path: str) {
    check {
        r = shell { test -f "$path" }
        if r { return ok.present }
        return err.absent
    }
}

# Deliver a file from the control host to the target (ADR-0036). `src` must be marked
# `%"…"` at the call site — an unmarked path would be read on the target, which is a
# copy, not a delivery. Binary-safe: the content travels as bytes, never through a shell
# variable, which would stop at the first null byte.
#
# No `observe`: the verdict comes from the work itself, as in `dir.copy`. `~file.write` is
# idempotent by content sha256 and reports whether it wrote, so asking a second question
# here would be a second implementation of one rule — free to drift, and it did: the
# `observe` this def used to carry asked *"does the destination exist"*, answered `true`
# forever after the first run, and left a changed source undelivered under an `ok.already`
# (#378).
def copy(src: str, dst: str) {
    apply {
        n = ~file.write(dst, ~file.read(src))
        if n == "0" { return ok.already }
        return ok.copied
    }
}

# Render a control-host template and deliver it (ADR-0036). An ordinary def since #334:
# `~file.render` runs on the control host, where the host's variables live, so per-host
# rendering (ADR-0024) works exactly as the Go transformation did.
#
# `src` must be marked `%"…"` at the call site: the control host reads the template
# itself, from what the plan declared. An unmarked path is refused rather than rendered —
# text the target chose was substituted over this host's variables until #392.
#
# A delegation (ADR-0037 §2): this def *is* `file.write`, with the rendered content as
# its argument. The callee's own phases therefore run in every mode — it decides whether
# the destination is already in sync, so `--dry-run` reports `already` on a converged host
# instead of announcing a write that would not happen.
#
# The `observe` this def grew in #334 is gone with it: re-deciding what `file.write`
# already knows was two implementations of one rule, free to drift.
def template(src: str, dst: str) {
    file.write(dst, ~file.render(src))
}
