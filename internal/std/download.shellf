def download-file(url: str, dst: str, sha256: str) {
    guard: shell {
        test -f "$dst" && echo "$sha256  $dst" | sha256sum -c --status
    } -> ok.already when ok

    apply {
        let r = shell {
            curl -fsSLo "$dst" "$url"
            echo "$sha256  $dst" | sha256sum -c --status
        }
        when r.exit != 0 -> err.runtime(r)
    }

    ok.downloaded
}
