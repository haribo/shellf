# A user-defined instruction, in a sibling file of the package (ADR-0014). It is
# resolved by name from plan.shellf with no import, shipped to the target, and
# evaluated there — observe/apply like any stdlib def.
def mark(path: str, content: str) {
    observe { return state(synced: shell { test -f "$path" && grep -qF -- "$content" "$path" }.exit == 0) }
    apply {
        r = shell { printf '%s\n' "$content" > "$path" }
        if !r { return err.runtime(r) }
        return ok.wrote
    }
}
