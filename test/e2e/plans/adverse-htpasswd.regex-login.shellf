# `htpasswd.entry` with two logins where one is a regex match of the other (#594, #598).
#
# The check allows `[A-Za-z0-9_.-]+`, so a `.` is a legal login character — and an
# unanchored wildcard in the pattern the observe builds: `grep "^$user:"` makes `a.b` match
# the line of `axb`. The apply gets this right (it compares a literal prefix through
# ENVIRON, since #487); the observe was not updated with it.
#
# The visible failure is an observe reading **another user's** hash and deciding from it.
on target {
    dir.ensure("/tmp/adv-htpasswd-regex")
    as root {
        # `axb` is written first, with a password of its own. `a.b` must not see this line.
        htpasswd.entry("/tmp/adv-htpasswd-regex/.htpasswd", "axb", "password-of-axb")
        htpasswd.entry("/tmp/adv-htpasswd-regex/.htpasswd", "a.b", "password-of-adotb")

        shell {
            f=/tmp/adv-htpasswd-regex/.htpasswd
            # Both accounts exist, each with its own line.
            [ "$(grep -c '^axb:' "$f")" = "1" ] || exit 1
            [ "$(grep -cF 'a.b:' "$f")" = "1" ] || exit 1
            # And each hash verifies against its own password, which is the whole point:
            # a wrong match would have made one line answer for the other.
            for pair in "axb:password-of-axb" "a.b:password-of-adotb"; do
                u="${pair%%:*}"; p="${pair#*:}"
                line=$(grep -F "$u:" "$f" | grep "^$(printf '%s' "$u" | sed 's/[.[\*^$]/\\&/g'):" | head -1)
                [ -n "$line" ] || exit 1
                hash=${line#*:}
                salt=$(printf '%s' "$hash" | cut -d'$' -f3)
                [ "$(printf '%s' "$p" | openssl passwd -apr1 -stdin -salt "$salt")" = "$hash" ] || exit 1
            done
        }
    }
}
