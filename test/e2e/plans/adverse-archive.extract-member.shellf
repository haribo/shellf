# `archive.extract-member` where the member name and the destination are hostile
# (#527, #535).
#
# Three arguments, and the member is the interesting one: it is a name chosen by whoever
# built the archive, not by the plan, and it reaches `tar xzOf "$src" "$member"` on both
# the observe and the apply sides. A member holding a space that splits there extracts the
# wrong thing — or nothing, which the observe reads as a sha mismatch and re-extracts for
# ever.
# Everything under `as root`, setup and call alike: the setup creates the tree, and a def
# called outside the block runs as the SSH user, which cannot write into it. Found by CI —
# a container where every step is root hides it completely.
on target {
    as root {
        unsafe shell {
            rm -rf /tmp/adv-archive-member
            mkdir -p "/tmp/adv-archive-member/src/in ner"
            printf 'the member\n' > "/tmp/adv-archive-member/src/in ner/a b'c.txt"
            printf 'other\n' > /tmp/adv-archive-member/src/other.txt
            tar czf /tmp/adv-archive-member/a.tar.gz -C /tmp/adv-archive-member/src .
        }

        archive.extract-member("/tmp/adv-archive-member/a.tar.gz",
                               "/tmp/adv-archive-member/out d'ir & f/extracted.txt",
                               "./in ner/a b'c.txt")
        shell {
            f="/tmp/adv-archive-member/out d'ir & f/extracted.txt"
            grep -qxF 'the member' "$f" || exit 1
            # The other member did not come along: this def extracts one, by name.
            grep -qxF 'other' "$f" && exit 1
            exit 0
        }
    }
}
