# `file.mode` owns the mode, and nothing else.
#
# Two orthogonal fields on one file. A def that reaches beyond its own is the #480 shape:
# a plan sets ownership, a later `file.mode` quietly takes it back, and every verdict on
# the way is green.
on target {
    dir.ensure("/tmp/adv-file-mode")
    as root {
        unsafe shell {
            printf 'x\n' > /tmp/adv-file-mode/f.txt
            chmod 644 /tmp/adv-file-mode/f.txt
            chown covuser /tmp/adv-file-mode/f.txt
        }
        file.mode("/tmp/adv-file-mode/f.txt", "640")
        shell {
            [ "$(stat -c '%a' /tmp/adv-file-mode/f.txt)" = "640" ] || exit 1
            [ "$(stat -c '%U' /tmp/adv-file-mode/f.txt)" = "covuser" ] || exit 1
        }
    }
}
