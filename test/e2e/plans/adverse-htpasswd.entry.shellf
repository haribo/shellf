# `htpasswd.entry` verifies the stored hash instead of comparing hashes.
#
# Two hostile shapes, and the first is the whole reason the def exists.
#
# 1. The user is already there with a hash of the **same** password, made with a different
#    salt — which is what a second `openssl passwd` always produces. A def comparing hashes
#    sees a difference and rewrites, forever; every `if x.changed { … }` downstream fires
#    with it. The file must come out untouched.
#
# 2. Another user's line sits in the same file. A def that rewrites the whole file — the
#    shape the dogfood wrote by hand — drops it, and that account silently loses access.
on target {
    dir.ensure("/tmp/adv-htpasswd")
    as root {
        unsafe shell {
            # A hash of "hunter2" under a fixed salt: the same password, a different hash.
            printf 'other:$apr1$zzzzzzzz$Ki2vQyLDBEpZmSPTFy7lD0\n' > /tmp/adv-htpasswd/users
            printf 'covadmin:%s\n' "$(printf 'hunter2' | openssl passwd -apr1 -stdin -salt abcdefgh)" \
                >> /tmp/adv-htpasswd/users
            chmod 600 /tmp/adv-htpasswd/users
            cp /tmp/adv-htpasswd/users /tmp/adv-htpasswd/before
        }
        htpasswd.entry("/tmp/adv-htpasswd/users", "covadmin", "hunter2")
        shell {
            # Same password already stored → nothing was rewritten, salt included.
            cmp -s /tmp/adv-htpasswd/before /tmp/adv-htpasswd/users || exit 1
            # And the neighbour is still there.
            grep -q '^other:' /tmp/adv-htpasswd/users || exit 1
        }

        # Now a real change: a different password must replace this user's line only.
        htpasswd.entry("/tmp/adv-htpasswd/users", "covadmin", "correct-horse")
        shell {
            # -F: a trailing `$` is grep's end-of-line anchor in a BRE, so the pattern
            # would look for a line ending in the salt rather than one containing it.
            grep -qF 'other:$apr1$zzzzzzzz$' /tmp/adv-htpasswd/users || exit 1
            [ "$(grep -c '^covadmin:' /tmp/adv-htpasswd/users)" = "1" ] || exit 1
            [ "$(stat -c '%a' /tmp/adv-htpasswd/users)" = "600" ] || exit 1
        }
    }
}
