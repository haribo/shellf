# `postgres.database` over a database that exists with the **wrong owner** (#594, #595).
#
# The apply runs `createdb -O "$owner"`, so the def promises ownership. The observe only
# asked whether a database of that name exists, so a database owned by somebody else was
# reported `already` and never corrected — the shape `fleet.shellf` would hit: an app role
# that cannot write to its own database, under a green run.
#
# `covrole` comes from `coverage.shellf`, which runs before these cases and already gave it
# the `pg_hba` line it needs. The wrong owner is `postgres` itself: it always exists, so the
# case needs no second role of its own.
on target {
    as root {
        # The database exists, owned by postgres rather than by covrole.
        unsafe shell {
            su - postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='advdb'\"" | grep -q 1 \
              || su - postgres -c "createdb advdb"
        }

        postgres.database("advdb", "covrole")

        shell {
            owner=$(su - postgres -c "psql -tAc \"SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname='advdb'\"" | tr -d ' ')
            [ "$owner" = "covrole" ] || exit 1
        }
    }
}
