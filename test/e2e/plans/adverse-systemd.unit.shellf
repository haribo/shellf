# `systemd.unit` judges a unit by what `systemd-analyze verify` *says*, not by its exit code.
#
# The exit code answers a different question than it appears to (#525), and backwards in
# both directions:
#
#   well-formed unit, ExecStart not on disk yet  ->  exit 1   (would be refused)
#   malformed unit, `Type=banana`                ->  exit 0   (would be accepted)
#
# The distinction that works is structural rather than a catalogue of messages: a problem
# **in the file** carries a line number (`…/x.service:5: Failed to parse …`), a problem with
# the **environment** does not (`x.service: Command … is not executable`). Only the first is
# knowable when the plan is read, and only the first is this def's business.
#
# Two shapes here, plus the stale-daemon one. The refusal case itself cannot live in this
# plan — an `err` halts the run — so it is step 27 of run.sh, which asserts that nothing
# was written.
on target {
    as root {
        # 1. A unit whose ExecStart does not exist yet. This is the ordinary shape: a plan
        #    delivers a script and the unit that calls it, so at check time the script is
        #    not there. It must install, not refuse — the first version halted every
        #    `--dry-run` of such a plan (#525, and #508's shape).
        unsafe shell { rm -f /etc/systemd/system/adv-pending.service; systemctl daemon-reload }
        systemd.unit("adv-pending.service", """
            [Unit]
            Description=adverse pending binary

            [Service]
            Type=oneshot
            ExecStart=/usr/local/bin/not-delivered-yet.sh
            """)
        shell { test -f /etc/systemd/system/adv-pending.service || exit 1 }

        # 2. The file on disk is already correct while the daemon has not been told: the
        #    state a host is in when someone writes a unit by hand and forgets the reload.
        unsafe shell {
            printf '[Unit]\nDescription=adverse probe\n\n[Service]\nType=oneshot\nExecStart=/bin/true\n' \
                > /etc/systemd/system/adv-stale.service
        }
        systemd.unit("adv-stale.service", """
            [Unit]
            Description=adverse probe

            [Service]
            Type=oneshot
            ExecStart=/bin/true
            """)
        shell {
            systemctl show -p Description --value adv-stale.service | grep -qx 'adverse probe' || exit 1
        }
    }
}
