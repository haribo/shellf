# A user def for the blog package (ADR-0014): the plan's own directory is loaded
# as a def package, so `data-dir` resolves by name with no import. Idempotent by
# an observed field, like any stdlib def.
# Two steps, two defs, and both tolerate being re-run — which is what ADR-0040 §1 asks of
# every step and what `mkdir && chmod` in a `shell { }` no longer parses for. The `observe`
# declares one dimension per effect: a directory that exists with the wrong mode is drift,
# and an observe that only asked `test -d` would call it converged.
def data-dir(path: str) as root {
    observe {
        return state(present: shell { test -d "$path" }.exit == 0, secured: shell { [ "$(stat -c '%a' "$path" 2>/dev/null)" = "700" ] }.exit == 0)
    }
    apply {
        dir.ensure(path)
        file.mode(path, "700")
        return ok.created
    }
}
