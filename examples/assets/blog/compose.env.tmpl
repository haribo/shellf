# Rendered by shellf per host. A shellf variable is written with an at-sign and braces,
# as on the lines below; docker-compose's own dollar-brace interpolation is left
# untouched (ADR-0021).
#
# The sigil is spelled out rather than shown: a template comment is still template text,
# so writing the marker here would ask shellf to substitute a variable that does not
# exist — which is exactly what this file did until it was first rendered (#356).
DOMAIN=@{domain}
DB_PASSWORD=@{db_password}
# compose reads ${DOMAIN} / ${DB_PASSWORD} below — passed through verbatim
VIRTUAL_HOST=${DOMAIN}
