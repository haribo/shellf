# Rendered per host by shellf. The database's address is read from the `db` host's own entry
# (ADR-0054), so it exists once in the inventory instead of being copied into every machine
# that needs it.
PGHOST=~{inventory.db.address}
PGPORT=5432
PGDATABASE=appdb
PGUSER=appuser
PGPASSWORD=~{db_password}
STATUS_FILE=/var/www/status/db.txt
