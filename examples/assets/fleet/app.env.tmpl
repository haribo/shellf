# Rendered per host by shellf. `~{inventory.db_address}` is this host's record of where the
# database lives — see docs/dogfood.md for why that is written twice rather than read from
# the `db` host's own entry.
PGHOST=~{inventory.db_address}
PGPORT=5432
PGDATABASE=appdb
PGUSER=appuser
PGPASSWORD=~{db_password}
STATUS_FILE=/var/www/status/db.txt
