# A small web server, provisioned idempotently over SSH.
#
#   shellf run examples/webserver/plan.shellf --inventory inventory.shellf --check
#   shellf run examples/webserver/plan.shellf --inventory inventory.shellf
#
# `--check` previews without touching anything; a second real run changes nothing
# (every instruction is idempotent).
on web {
    # Install the web server. `pkg` is a per-host variable from the inventory.
    apt.install(pkg)

    # A content directory (also a per-host variable) and an index page.
    dir-ensure(webroot)
    file-write("/opt/dogfood/index.html", "hello from shellf")

    # The service: running and enabled.
    service("nginx", "true", "true")

    # Drop a marker only once the directory really exists (a read-only question).
    if dir-exists(webroot) { file-write("/opt/dogfood/ready", "ok") }

    # Error handling: an optional package that may not exist. `?` catches its
    # failure so it does not halt the run; anything uncaught would.
    x = apt.install("no-such-pkg-shellf-xyz")?
    if x == err.runtime { shell { logger "shellf: optional package absent, continuing" } }
}
