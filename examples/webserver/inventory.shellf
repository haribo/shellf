# Fill in address/key for your target. `pkg` and `webroot` are free-form
# per-host variables consumed by the plan.
#
# The plan escalates with `as root`, so a non-root user works as long as it can
# sudo (passwordless sudo is the common setup). Use `root` directly if you SSH
# as root.
host web = {
    address: "10.0.0.10",
    user: "deploy",
    key: "~/.ssh/id_deploy",
    pkg: "nginx",
    webroot: "/opt/dogfood"
}
