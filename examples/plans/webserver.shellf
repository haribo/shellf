# A small web server, provisioned idempotently over SSH as a non-root user.
#
#   shellf run --inventory examples/inventories/inventory.shellf --dry-run examples/plans/webserver.shellf
#   shellf run --inventory examples/inventories/inventory.shellf       examples/plans/webserver.shellf
#   shellf status --inventory examples/inventories/inventory.shellf    examples/plans/webserver.shellf
#
# Flags come before the plan file. `--dry-run` previews without touching anything;
# `status` reports current-vs-desired; a second real run changes nothing (every
# instruction is idempotent). Root is reached via `as root` — either intrinsically
# (the def declares it) or by wrapping.
#
# The inventory lives OUTSIDE this directory on purpose: a plan's directory is its
# def package (ADR-0014), so every sibling `*.shellf` is loaded as a def — an
# inventory kept here would be parsed as one and fail.
on web {
    # These defs declare `as root` themselves, so they escalate automatically
    # even when you SSH as a non-root user.
    apt.install(pkg)
    service.ensure("nginx", "true", "true")

    # `dir.ensure` / `file.write` are generic (they might target a home dir or a
    # system path), so the caller escalates when the path needs root.
    as root {
        dir.ensure(webroot)
        file.write("/opt/dogfood/index.html", "hello from shellf")
        if dir.exists(webroot) { file.write("/opt/dogfood/ready", "ok") }
    }

    # Error handling: an optional package that may not exist. `?` catches its
    # failure so it does not halt the run; anything uncaught would.
    x = apt.install("no-such-pkg-shellf-xyz")?
    if x == err.runtime {
        shell { logger "shellf: optional package absent, continuing" }
    } else {
        shell { logger "shellf: optional package present" }
    }

    # **The idiom that makes a config tool worth using.** `cfg.changed` is true only when
    # this run actually rewrote the file — not when it was already correct. Gate the
    # restart on it and a converged run restarts nothing; forget it, and every run bounces
    # the service for no reason.
    as root {
        cfg = file.write("/etc/nginx/conf.d/shellf.conf", "# managed by shellf\n")
        if cfg.changed { service.restart("nginx") }
    }
}
