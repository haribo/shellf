# A two-host deployment: a database on one machine, the service that reads it on another.
#
#   shellf run --inventory examples/inventories/inventory.shellf \
#     --secret-file db_password=./db_password \
#     --dry-run examples/plans/fleet.shellf
#
# `hosting.shellf` measured the language on **one** machine. This one measures what only
# appears with two: a host that must know another host's address, an ordering constraint
# between blocks, and a service whose readiness depends on a machine it does not run on.
#
# Read `docs/dogfood.md` for what it found. As with `hosting.shellf`, the number to watch is
# the `unsafe shell` count, and it is now **zero** — the one block this plan needed became
# `postgres.role` / `postgres.database` (#545). A later version that needs one again has
# found a gap worth an issue (ADR-0040 §3).

# ---- the database host ---------------------------------------------------------------
on db {
    apt.update()
    apt.install("postgresql")

    # Listen beyond localhost: the point of this deployment is that another machine
    # connects.
    #
    # `postgres.config` and `postgres.hba` ask postgres where its files are, so no major
    # version is written here (#546, #567). Both answer while the server is **down**, which
    # is when a first deployment configures it.
    #
    # The value is passed **unquoted**: the def quotes it, because PostgreSQL needs
    # `'127.0.0.1'` and rejects it bare. A caller who quotes too is refused rather than
    # having the quotes doubled into the file.
    postgres.config("listen_addresses", "*")

    # Let the app host authenticate. Append-if-absent, matched on the whole line.
    postgres.hba("host all appuser 0.0.0.0/0 scram-sha-256")

    service.ensure("postgresql", "true", "true")
    service.restart("postgresql")

    # The role and its database. `postgres.role` verifies the password by connecting with
    # it rather than trusting that the role exists — which is why the `pg_hba` line above
    # comes first, and why it admits `all` rather than one database: the check connects to
    # the `postgres` maintenance database (#545).
    postgres.role("appuser", db_password)
    postgres.database("appdb", "appuser")

    ufw.default("deny", "allow")
    ufw.open("22", "tcp")
    ufw.open("5432", "tcp")
    ufw.enable()
}

# ---- the application host --------------------------------------------------------------
# Its own machine, not the one `blog.shellf` provisions: both bind :80, and an example that
# collides with another example is testing the harness rather than the language.
on svc {
    apt.update()
    apt.install("postgresql-client")
    apt.install("nginx")

    as root { dir.ensure("/var/www/status") }

    # The connection details, rendered on the control host so the password never lands in
    # the plan or in a shell argument (ADR-0018/0024).
    #
    # The template reads `~{inventory.db.address}` — the database host's own entry, not a
    # copy carried here. ADR-0052 had left that form out of scope pending a real deployment
    # that needed it; this was that deployment, and ADR-0054 is what it produced. The
    # address now exists once in the inventory.
    as root {
        file.template(%"fleet/app.env.tmpl", "/etc/appdb.env")
        file.mode("/etc/appdb.env", "0640")

        file.copy(%"fleet/db-status.sh", "/usr/local/bin/db-status")
        file.mode("/usr/local/bin/db-status", "0755")
    }

    # A timer that republishes the database's reachability as a static file nginx serves.
    systemd.unit("db-status.service", """
        [Unit]
        Description=Publish database reachability

        [Service]
        Type=oneshot
        EnvironmentFile=/etc/appdb.env
        ExecStart=/usr/local/bin/db-status
        """)

    systemd.unit("db-status.timer", """
        [Unit]
        Description=Run the database check every minute

        [Timer]
        OnBootSec=10s
        OnUnitActiveSec=1min

        [Install]
        WantedBy=timers.target
        """)

    service.ensure("db-status.timer", "true", "true")
    service.ensure("nginx", "true", "true")
}
