# Targets for the examples. Authentication uses your ssh-agent by default
# (ADR-0026); to pin a key instead, uncomment `key:` on a host or in `defaults`.
#
# The plans escalate with `as root`, so a non-root user works as long as it can
# sudo (passwordless sudo is the common setup); use `root` directly if you SSH as
# root. `pkg`/`webroot`/`domain` are free-form per-host variables; a plan reads them
# as `${inventory.pkg}`, never as a bare `pkg` — the prefix is the only way in, so a
# name never means two things at once (#540, ADR-0053).

host web = {
    address: "10.0.0.10",
    user: "deploy",
    # key: "~/.ssh/id_deploy",   # optional override — ssh-agent is the default
    pkg: "nginx",
    webroot: "/opt/dogfood"
}

host app = {
    address: "10.0.0.20",
    user: "deploy",
    domain: "blog.example.com"
}

# The service half of `fleet.shellf`. A machine of its own: `app` already runs the blog
# stack on :80, and two examples fighting over a port test nothing about shellf.
#
# It carries no copy of the database's address: the plan reads `${inventory.db.address}`
# from `db`'s own entry (ADR-0054). That duplication is what the two-host dogfood measured,
# and removing it is what the ADR was written for.
host svc = {
    address: "10.0.0.50",
    user: "deploy"
}

# The database `fleet.shellf` deploys. Its address is declared here and nowhere else.
host db = {
    address: "10.0.0.40",
    user: "deploy"
}

# The host `hosting.shellf` targets. `healthz` used to sit here as a whole URL repeating
# `domain`, because a per-host variable could not be composed into a string. The plan now
# builds it with `${inventory.domain}`, so the domain is written once (#509, ADR-0052).
host edge = {
    address: "10.0.0.30",
    user: "deploy",
    domain: "app.example.test",
    acme_email: "ops@example.test",
    repo: "https://git.example.test/app.git",
    ref: "v1.4.0"
}
